# VSRP DDoS Monitor - Umgebungskonfiguration
# Diese Datei nach ".env" kopieren und ausfuellen. ".env" enthaelt Zugangsdaten,
# wird NICHT eingecheckt (siehe .gitignore) und darf nur per SFTP direkt auf den
# Server uebertragen werden - niemals per git push/pull.

# --- Datenbank (MySQL/MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Zufaelliger, langer String zur Absicherung der Web-Sessions
# Erzeugen z. B. mit: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Anzeigename, Basis-URL (fuer Links in Alarm-Mails/Discord) und Zeitzone
APP_NAME="VSRP DDoS Monitor"
BASE_URL=https://ddos.viennastaterp.at
APP_TIMEZONE=Europe/Vienna

# --- E-Mail (SMTP) fuer Alarmierung ---
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS, Port 587) | ssl (SSL/TLS, Port 465) | none
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="VSRP DDoS Monitor"
# Empfaenger der Alarm-Mails, mehrere durch Komma trennen
ALERT_EMAIL_TO=

# --- Discord-Benachrichtigung ---
DISCORD_WEBHOOK_URL=
